.market-board{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin:8px 0 17px}.market-board article{min-width:0;padding:8px 3px;border:1px solid var(--line);border-radius:13px;background:rgba(5,26,36,.78);display:grid;place-items:center;gap:2px;text-align:center}.market-board article.hot{border-color:rgba(240,197,106,.42);background:rgba(87,59,27,.48)}.market-board article>span{font-size:17px;color:var(--accent)}.market-board article.hot>span{color:var(--accent-2)}.market-board small{font-size:7px;color:var(--muted);white-space:nowrap}.market-board b{font-size:9px;color:#7ee5b8}.market-board b:has(+*){color:inherit}.inventory-list,.shop-list,.upgrade-list,.quest-list{display:grid;gap:8px}.inventory-card{padding:10px;border:1px solid var(--line);border-radius:18px;background:rgba(5,27,37,.86);display:grid;grid-template-columns:44px 1fr;gap:9px}.species-token{width:44px;height:44px;border-radius:15px;display:grid;place-items:center;background:rgba(255,255,255,.05);color:#d9e7e4}.species-token.rarity-uncommon{background:rgba(117,227,179,.09);color:#75e3b3}.species-token.rarity-rare{background:rgba(114,181,255,.1);color:#72b5ff}.species-token.rarity-epic{background:rgba(219,140,255,.12);color:#db8cff}.inventory-copy{min-width:0}.inventory-copy>div{display:flex;gap:4px}.rarity,.grade{padding:3px 5px;border-radius:6px;background:rgba(255,255,255,.06);font-size:7px}.rarity-uncommon{color:#75e3b3}.rarity-rare{color:#72b5ff}.rarity-epic{color:#db8cff}.inventory-copy h3{font-size:13px;margin:4px 0 2px}.inventory-copy h3 small{font-size:9px;color:var(--muted)}.inventory-copy p{margin:0;font-size:9px;color:var(--muted)}.freshness{font-style:normal}.freshness.fresh{color:#80e4c1}.freshness.good{color:#b8dfb3}.freshness.normal{color:#eccd7a}.freshness.old{color:#ff918b}.price-buttons{grid-column:1/3;display:grid;grid-template-columns:1fr 1fr;gap:6px}.price-buttons button{height:43px;border-radius:12px;border:1px solid rgba(182,225,211,.1);background:rgba(3,18,26,.6);display:flex;align-items:center;justify-content:space-between;padding:0 10px}.price-buttons button.best{border-color:rgba(128,228,193,.42);background:rgba(56,120,99,.18)}.price-buttons small{font-size:8px;color:var(--muted)}.price-buttons b{font-size:11px;color:var(--accent)}.wide-cta{width:100%;height:50px;margin-top:10px;border-radius:15px;background:linear-gradient(135deg,#76dbbb,#a4efd5);color:#082923;font-size:12px;font-weight:900}.shop-row{min-height:76px;padding:10px;border:1px solid var(--line);border-radius:17px;background:rgba(5,27,37,.84);display:grid;grid-template-columns:40px 1fr auto;gap:9px;align-items:center}.shop-row>span{width:40px;height:40px;border-radius:13px;background:rgba(128,228,193,.08);color:var(--accent);display:grid;place-items:center}.shop-row>span .ui-icon{width:19px}.shop-row>div{min-width:0}.shop-row small{display:block;font-size:8px;color:var(--muted)}.shop-row b{display:block;font-size:12px;margin:2px 0}.shop-row p{margin:0;font-size:8px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.shop-row button{height:34px;padding:0 9px;border-radius:10px;background:rgba(128,228,193,.12);color:var(--accent);font-size:9px;font-weight:800}

/* Collection */
.collection-summary{padding:14px;border:1px solid rgba(114,181,255,.18);border-radius:20px;background:linear-gradient(135deg,rgba(25,62,78,.82),rgba(5,28,38,.87));margin:8px 0 12px}.collection-summary>div:first-child{display:flex;align-items:baseline;gap:4px}.collection-summary b{font-size:28px;color:#8bc6ff}.collection-summary span{font-size:12px;color:var(--muted)}.collection-progress{height:6px;margin:8px 0;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden}.collection-progress i{display:block;height:100%;background:linear-gradient(90deg,#70b6fb,#7fe4c1);border-radius:6px}.collection-summary p{margin:0;font-size:9px;color:#b8cecd}.collection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.collection-item{aspect-ratio:.88;padding:8px 5px;border:1px solid var(--line);border-radius:17px;background:rgba(5,26,36,.84);display:grid;place-items:center;align-content:center;gap:3px}.collection-item>span{width:42px;height:42px;border-radius:15px;background:rgba(255,255,255,.05);display:grid;place-items:center}.collection-item>span .species-glyph{width:27px;height:27px}.collection-item small{font-size:7px;color:var(--muted)}.collection-item b{font-size:10px}.collection-item i{font-size:7px;color:var(--muted);font-style:normal}.collection-item.rarity-uncommon{border-color:rgba(117,227,179,.23);color:#b7f0d4}.collection-item.rarity-rare{border-color:rgba(114,181,255,.28);color:#b9d9ff}.collection-item.rarity-epic{border-color:rgba(219,140,255,.3);color:#e7bdff}.collection-item.unknown{opacity:.48;filter:saturate(.2)}

/* Village */
.story-panel{padding:14px;border:1px solid rgba(240,197,106,.2);border-radius:21px;background:linear-gradient(135deg,rgba(70,48,25,.66),rgba(6,27,37,.88));margin:8px 0 11px}.story-map{position:relative;display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:13px}.map-line{position:absolute;left:5%;right:5%;top:15px;height:2px;background:rgba(255,255,255,.1)}.story-map i{position:relative;z-index:1;width:30px;height:30px;justify-self:center;border-radius:50%;background:#15323d;border:2px solid rgba(255,255,255,.1);display:grid;place-items:center;font-size:9px;font-style:normal;color:var(--muted)}.story-map i.done{background:#3d806b;border-color:#80e4c1;color:#061b18}.story-map i.current{background:#866c32;border-color:#f0c56a;color:#fff;box-shadow:0 0 0 5px rgba(240,197,106,.08)}.story-current small{font-size:8px;color:var(--accent-2);letter-spacing:.13em}.story-current h2{font-size:17px;margin:4px 0}.story-current p{margin:0;color:#c1cbc4;font-size:10px}.npc-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:14px}.npc-row article{padding:8px;border:1px solid var(--line);border-radius:16px;background:rgba(5,26,36,.8);display:grid;place-items:center;text-align:center;gap:4px}.npc-row article>span{width:38px;height:38px;border-radius:14px;background:color-mix(in srgb,var(--npc) 24%,transparent);border:1px solid color-mix(in srgb,var(--npc) 42%,transparent);display:grid;place-items:center;font-size:13px;font-weight:900}.npc-row small{display:block;font-size:7px;color:var(--muted)}.npc-row b{font-size:10px}.npc-row p{display:none}.quest-card{padding:10px;border:1px solid var(--line);border-radius:17px;background:rgba(5,27,37,.84);display:grid;grid-template-columns:34px 1fr auto;gap:9px;align-items:center}.quest-card.ready{border-color:rgba(240,197,106,.35)}.quest-card.claimed{opacity:.55}.quest-card>span{width:34px;height:34px;border-radius:12px;background:rgba(128,228,193,.08);display:grid;place-items:center;color:var(--accent);font-size:9px;font-weight:900}.quest-card>span .ui-icon{width:18px}.quest-card>div{min-width:0}.quest-card small{font-size:8px;color:var(--accent)}.quest-card h3{font-size:12px;margin:2px 0}.quest-card p{margin:0;font-size:8px;color:var(--muted)}.quest-progress{height:4px;background:rgba(255,255,255,.07);border-radius:4px;overflow:hidden;margin:6px 0 4px}.quest-progress i{display:block;height:100%;background:var(--accent);border-radius:4px}.quest-card em{font-size:8px;color:#d7c386;font-style:normal}.quest-card>button{height:34px;padding:0 8px;border-radius:10px;background:var(--accent-2);color:#352b10;font-size:8px;font-weight:900}.upgrade-card{padding:10px;border:1px solid var(--line);border-radius:17px;background:rgba(5,27,37,.84);display:grid;grid-template-columns:40px 1fr auto;gap:9px;align-items:center}.upgrade-card>span{width:40px;height:40px;border-radius:13px;background:rgba(114,181,255,.09);color:#82bdfb;display:grid;place-items:center}.upgrade-card>span .ui-icon{width:20px}.upgrade-card>div{min-width:0}.upgrade-card small{font-size:8px;color:#82bdfb}.upgrade-card h3{font-size:12px;margin:2px 0}.upgrade-card p{font-size:8px;color:var(--muted);margin:0;line-height:1.45}.level-dots{display:flex;gap:3px;margin-top:5px}.level-dots i{width:17px;height:3px;border-radius:3px;background:rgba(255,255,255,.08)}.level-dots i.on{background:#82bdfb}.upgrade-card>button{min-width:74px;min-height:34px;padding:5px 8px;border-radius:10px;background:rgba(114,181,255,.13);color:#9bceff;font-size:8px;font-weight:800}.trap-shop{grid-template-columns:40px 1fr minmax(70px,auto)}.trap-shop>div:last-child{display:grid;gap:4px}.trap-shop>div:last-child button{width:100%}.management-actions{display:grid;gap:7px}.management-actions>button{min-height:58px;border:1px solid var(--line);border-radius:16px;background:rgba(5,27,37,.84);display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:center;text-align:left;padding:9px 12px}.management-actions>button>.ui-icon{width:21px;color:var(--accent)}.management-actions span{display:grid;gap:2px}.management-actions b{font-size:11px}.management-actions small{font-size:8px;color:var(--muted)}

/* Modal and toast */
.modal-root{position:absolute;inset:0;z-index:20;display:none;align-items:flex-end;justify-content:center;padding:18px 12px calc(18px + var(--safe-bottom))}.modal-root.open{display:flex}.modal-backdrop{position:absolute;inset:0;background:rgba(0,8,13,.72);backdrop-filter:blur(8px);animation:fade-in .18s ease both}.modal-card{position:relative;z-index:1;width:100%;max-height:88%;overflow-y:auto;padding:20px 16px 16px;border:1px solid rgba(190,232,218,.17);border-radius:26px;background:linear-gradient(180deg,#0b2a37,#071a24);box-shadow:0 30px 80px rgba(0,0,0,.6);animation:modal-up .22s ease both;scrollbar-width:none}.modal-card::-webkit-scrollbar{display:none}.modal-close{position:absolute;right:12px;top:12px;width:34px;height:34px;border-radius:12px;background:rgba(255,255,255,.06);display:grid;place-items:center}.modal-close .ui-icon{width:17px}.modal-heading{padding-right:34px}.modal-heading.center{text-align:center;padding:0}.modal-heading h2{font-size:22px;line-height:1.2;margin:5px 0 8px}.modal-heading p{margin:0;color:var(--muted);font-size:10px;line-height:1.6}.modal-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:7px;margin-top:14px}.modal-actions button,.modal-primary{min-height:48px;border-radius:14px;background:rgba(255,255,255,.07);font-size:11px;font-weight:800}.modal-actions .primary,.modal-primary{background:linear-gradient(135deg,#77dcbc,#a3efd4);color:#072822}.modal-actions .danger,.danger-button{background:rgba(255,117,110,.15);color:#ff9892}.modal-primary{width:100%;margin-top:14px}.result-emblem{width:74px;height:74px;margin:0 auto 12px;border-radius:26px;background:rgba(128,228,193,.1);color:var(--accent);display:grid;place-items:center}.result-emblem .ui-icon{width:38px;height:38px}.result-emblem.perfect,.result-emblem.success{background:rgba(240,197,106,.12);color:var(--accent-2);box-shadow:0 0 40px rgba(240,197,106,.1)}.result-emblem.unstable,.result-emblem.partial{background:rgba(255,117,110,.1);color:#ff918b}.result-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:13px}.result-summary span,.detail-grid span,.profile-stats span{padding:9px;border-radius:12px;background:rgba(1,16,23,.45);text-align:center;min-width:0}.result-summary small,.detail-grid small,.profile-stats small{display:block;font-size:7px;color:var(--muted)}.result-summary b,.detail-grid b,.profile-stats b{display:block;font-size:10px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.detail-hero{text-align:center;padding:8px 0 13px}.detail-hero>span{width:78px;height:78px;margin:auto;border-radius:26px;background:rgba(255,255,255,.06);display:grid;place-items:center}.detail-hero .species-glyph{width:44px;height:44px}.detail-hero h2{font-size:22px;margin:5px 0}.detail-hero p{margin:0;color:var(--muted);font-size:10px}.detail-grid,.profile-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.detail-origin{margin-top:10px;padding:11px;border-radius:15px;background:rgba(1,16,23,.42);display:grid;grid-template-columns:38px 1fr;gap:9px;align-items:center}.detail-origin>span{width:38px;height:38px;border-radius:13px;background:rgba(128,228,193,.09);color:var(--accent);display:grid;place-items:center}.detail-origin small{font-size:8px;color:var(--muted)}.detail-origin b{display:block;font-size:12px;margin:2px 0}.detail-origin p{font-size:8px;margin:0;color:var(--muted)}.settings-list{display:grid;gap:7px;margin:14px 0}.settings-list label{height:48px;padding:0 11px;border-radius:14px;background:rgba(1,16,23,.42);display:flex;align-items:center;justify-content:space-between}.settings-list label>span{display:flex;align-items:center;gap:9px}.settings-list .ui-icon{width:19px;color:var(--accent)}.settings-list b{font-size:11px}.settings-list input{appearance:none;width:42px;height:24px;border-radius:13px;background:rgba(255,255,255,.1);position:relative;transition:.18s}.settings-list input:after{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;border-radius:50%;background:#91a6a2;transition:.18s}.settings-list input:checked{background:rgba(128,228,193,.35)}.settings-list input:checked:after{left:21px;background:var(--accent)}.danger-button{width:100%;height:44px;margin-top:12px;border-radius:13px}.tutorial-art{height:86px;position:relative;display:grid;place-items:center}.tutorial-art>span{width:65px;height:65px;border-radius:23px;background:rgba(128,228,193,.1);color:var(--accent);display:grid;place-items:center}.tutorial-art .ui-icon{width:35px;height:35px}.tutorial-art i{position:absolute;left:50%;top:63px;width:2px;height:25px;background:linear-gradient(var(--accent),transparent)}.tutorial-steps{display:grid;gap:6px;margin-top:13px}.tutorial-steps span{padding:9px 10px;border-radius:12px;background:rgba(1,16,23,.42);display:flex;align-items:center;gap:8px;font-size:9px}.tutorial-steps b{width:22px;height:22px;border-radius:8px;background:rgba(128,228,193,.1);color:var(--accent);display:grid;place-items:center}.catch-list{display:grid;gap:6px;margin-top:14px}.catch-reveal{padding:9px;border:1px solid var(--line);border-radius:15px;background:rgba(1,16,23,.45);display:grid;grid-template-columns:40px 1fr auto;gap:9px;align-items:center;animation:catch-in .3s calc(var(--delay,0ms) + .08s) ease both}.catch-reveal>span{width:40px;height:40px;border-radius:13px;background:rgba(255,255,255,.05);display:grid;place-items:center}.catch-reveal>span .species-glyph{width:23px}.catch-reveal small{font-size:7px;color:var(--muted)}.catch-reveal h3{font-size:12px;margin:2px 0}.catch-reveal h3 i{font-size:9px;color:var(--muted);font-style:normal}.catch-reveal p{margin:0;font-size:8px;color:var(--muted)}.catch-reveal>b{font-size:10px;color:var(--accent-2)}.empty-result{padding:14px;border-radius:14px;background:rgba(1,16,23,.42);margin-top:13px}.empty-result p{margin:0;font-size:10px;line-height:1.6;color:var(--muted)}
.toast-root{position:absolute;z-index:50;left:16px;right:16px;top:calc(16px + var(--safe-top));display:grid;gap:6px;pointer-events:none}.toast{justify-self:center;max-width:100%;padding:10px 14px;border:1px solid var(--line);border-radius:13px;background:rgba(7,29,39,.96);box-shadow:0 12px 30px rgba(0,0,0,.35);font-size:10px;opacity:0;transform:translateY(-8px);transition:.2s}.toast.show{opacity:1;transform:none}.toast.success{border-color:rgba(128,228,193,.35)}.toast.error{border-color:rgba(255,117,110,.4);color:#ffaaa5}

/* Minigames */
.minigame-app{background:linear-gradient(180deg,rgba(4,18,26,.04),rgba(4,18,26,.35))}.minigame{height:100%;display:flex;flex-direction:column;padding:calc(10px + var(--safe-top)) 14px calc(14px + var(--safe-bottom));position:relative}.game-header{min-height:50px;display:grid;grid-template-columns:40px 1fr auto;gap:9px;align-items:center}.game-header>button{width:38px;height:38px;border-radius:13px;background:rgba(3,19,27,.6);border:1px solid var(--line);display:grid;place-items:center}.game-header>button .ui-icon{width:18px}.game-header small{display:block;font-size:8px;color:var(--accent);letter-spacing:.15em}.game-header h1{font-size:15px;margin:2px 0}.game-header>span{height:34px;padding:0 10px;border-radius:11px;background:rgba(3,19,27,.65);border:1px solid var(--line);display:grid;place-items:center;font-size:10px;font-weight:800}.deploy-copy{margin-top:auto;padding:0 10px 12px;text-align:center;text-shadow:0 2px 12px rgba(0,0,0,.6)}.deploy-copy h2{font-size:22px;line-height:1.25;margin:5px auto 8px;max-width:340px}.deploy-copy p{margin:0 auto;max-width:330px;font-size:9px;color:#c0d3ce}.deploy-controller{margin:0 0 1px;padding:16px;border:1px solid rgba(187,231,217,.18);border-radius:24px;background:rgba(4,23,32,.9);box-shadow:0 20px 50px rgba(0,0,0,.35);backdrop-filter:blur(12px)}.deploy-gauge,.timing-gauge{height:25px;border-radius:13px;background:linear-gradient(90deg,rgba(255,117,110,.26),rgba(113,216,183,.08) 30%,rgba(113,216,183,.08) 70%,rgba(255,117,110,.26));position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.08)}.target-zone,.timing-zone{position:absolute;top:3px;bottom:3px;border-radius:10px;background:linear-gradient(90deg,rgba(128,228,193,.46),rgba(173,245,217,.7));box-shadow:0 0 15px rgba(128,228,193,.28)}.gauge-marker,.timing-marker{position:absolute;left:0;top:-4px;width:4px;height:33px;border-radius:3px;background:#fff5d4;box-shadow:0 0 12px #fff5d4;transform:translateX(-50%)}.gauge-labels{display:flex;justify-content:space-between;margin:7px 2px 14px;font-size:8px;color:var(--muted)}.gauge-labels b{color:var(--accent)}.drop-button{width:100%;height:65px;border-radius:18px;background:linear-gradient(135deg,#77dcbc,#a4efd5);color:#082923;display:grid;grid-template-columns:42px 1fr;gap:9px;align-items:center;text-align:left;padding:9px 13px}.drop-button>span{width:40px;height:40px;border-radius:13px;background:rgba(0,0,0,.1);display:grid;place-items:center}.drop-button b{display:block;font-size:13px}.drop-button small{display:block;font-size:9px;opacity:.72;margin-top:2px}
