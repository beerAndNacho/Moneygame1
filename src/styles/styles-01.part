:root {
  color-scheme: dark;
  --bg:#06141e;
  --panel:rgba(7,27,38,.86);
  --panel-strong:rgba(8,31,43,.96);
  --line:rgba(183,232,220,.14);
  --text:#f2f6eb;
  --muted:#9db9b5;
  --accent:#80e4c1;
  --accent-2:#f0c56a;
  --danger:#ff756e;
  --blue:#72b5ff;
  --radius:22px;
  --safe-top:env(safe-area-inset-top, 0px);
  --safe-bottom:env(safe-area-inset-bottom, 0px);
  font-family:Inter, Pretendard, "Noto Sans KR", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis:none;
  text-rendering:optimizeLegibility;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);-webkit-tap-highlight-color:transparent;overscroll-behavior:none}
button,input{font:inherit;color:inherit}
button{border:0;cursor:pointer}
button:disabled{cursor:not-allowed;opacity:.44}
svg{display:block}
.ui-icon,.species-glyph{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.game-shell{position:relative;width:100%;height:100%;max-width:520px;margin:auto;overflow:hidden;background:#071722;box-shadow:0 0 80px rgba(0,0,0,.45)}
#ocean-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.app{position:absolute;inset:0;z-index:1}
.screen-shell{height:100%;display:flex;flex-direction:column;background:linear-gradient(180deg,rgba(3,16,24,.08) 0,rgba(4,18,27,.42) 25%,rgba(5,17,25,.96) 48%,#06141e 100%)}
.screen-scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:12px 16px calc(110px + var(--safe-bottom));scrollbar-width:none}
.screen-scroll::-webkit-scrollbar,.setup-scroll::-webkit-scrollbar{display:none}

.top-hud{height:calc(70px + var(--safe-top));padding:calc(12px + var(--safe-top)) 14px 8px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex:0 0 auto;background:linear-gradient(180deg,rgba(3,13,21,.82),rgba(3,13,21,.12));backdrop-filter:blur(4px)}
.day-chip,.hud-center{display:flex;align-items:center;gap:9px;min-width:0}.day-chip>span{width:34px;height:34px;border:1px solid var(--line);border-radius:12px;display:grid;place-items:center;background:rgba(6,28,39,.72);font-size:18px}.day-chip div,.hud-center{display:grid;min-width:0}.day-chip small,.hud-center small{font-size:10px;color:var(--muted);letter-spacing:.04em}.day-chip b,.hud-center b{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hud-center{text-align:center}.hud-icon{width:38px;height:38px;border-radius:13px;background:rgba(8,30,41,.82);border:1px solid var(--line);display:grid;place-items:center}.hud-icon .ui-icon{width:20px;height:20px}
.hud-actions{display:flex;align-items:center;gap:6px}.coin-chip,.ready-chip,.level-chip{height:36px;border-radius:13px;background:rgba(6,25,35,.82);border:1px solid var(--line);display:flex;align-items:center;justify-content:center}.coin-chip{gap:5px;padding:0 9px}.coin-chip .ui-icon{width:16px;height:16px;color:var(--accent-2)}.coin-chip b{font-size:12px}.ready-chip{width:36px;position:relative;color:var(--accent-2)}.ready-chip .ui-icon{width:18px}.ready-chip b{position:absolute;right:-2px;top:-4px;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--danger);display:grid;place-items:center;font-size:9px;color:#fff}.level-chip{display:grid;grid-template-columns:auto 28px;gap:5px;padding:0 8px}.level-chip b{font-size:10px}.level-chip span{height:4px;border-radius:4px;background:rgba(255,255,255,.12);overflow:hidden}.level-chip i{display:block;height:100%;background:var(--accent);border-radius:4px}

.bottom-nav{position:absolute;z-index:4;left:10px;right:10px;bottom:calc(8px + var(--safe-bottom));height:70px;padding:7px 4px;display:grid;grid-template-columns:repeat(5,1fr);border:1px solid rgba(189,231,219,.14);border-radius:23px;background:rgba(4,20,29,.92);box-shadow:0 16px 40px rgba(0,0,0,.44);backdrop-filter:blur(16px)}
.nav-item{position:relative;border-radius:17px;background:transparent;color:#789993;display:grid;place-items:center;align-content:center;gap:2px}.nav-item .ui-icon{width:21px;height:21px}.nav-item span{font-size:9px;font-weight:700}.nav-item.active{background:rgba(119,225,190,.13);color:var(--accent)}.nav-item i{position:absolute;top:2px;right:12px;min-width:16px;height:16px;padding:0 4px;border-radius:9px;background:var(--danger);color:#fff;font-size:9px;font-style:normal;display:grid;place-items:center}

.harbor-hero{min-height:235px;padding:105px 12px 20px;text-align:center;display:grid;place-items:center;align-content:end}.kicker,.page-heading>small,.section-heading small,.modal-heading>small,.detail-hero>small,.deploy-copy>small{font-size:10px;letter-spacing:.18em;font-weight:800;color:var(--accent)}.harbor-hero h1{font-size:40px;line-height:1;margin:7px 0 8px;text-shadow:0 4px 24px rgba(0,0,0,.5)}.harbor-hero>p{max-width:330px;margin:0;color:#c1d6cf;font-size:12px;line-height:1.55}.hero-stats{display:flex;gap:8px;margin-top:16px}.hero-stats>span{width:86px;padding:9px 7px;border:1px solid var(--line);border-radius:15px;background:rgba(4,25,35,.68);display:grid;grid-template-columns:22px 1fr;grid-template-rows:auto auto;align-items:center;text-align:left}.hero-stats .ui-icon{grid-row:1/3;width:18px;color:var(--accent)}.hero-stats b{font-size:15px}.hero-stats small{font-size:9px;color:var(--muted)}
.story-strip{width:100%;margin:0 0 14px;padding:13px;border:1px solid rgba(238,198,105,.22);border-radius:18px;background:linear-gradient(135deg,rgba(87,60,30,.66),rgba(19,38,42,.8));display:grid;grid-template-columns:42px 1fr 20px;gap:11px;align-items:center;text-align:left}.story-strip>span{width:42px;height:42px;border-radius:14px;background:rgba(240,197,106,.14);display:grid;place-items:center;color:var(--accent-2);font-weight:900}.story-strip div{min-width:0}.story-strip small{display:block;font-size:9px;color:#e5c983;letter-spacing:.08em}.story-strip b{display:block;font-size:14px;margin:2px 0}.story-strip p{margin:0;font-size:10px;color:#b8c8c3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.story-strip>.ui-icon{width:18px;color:#d5c18d}.story-strip.complete{grid-template-columns:42px 1fr;background:rgba(31,74,59,.63);border-color:rgba(128,228,193,.2)}
.section-block{margin:14px 0 18px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:10px;margin:0 2px 10px}.section-heading h2{font-size:18px;margin:3px 0 0}.section-heading button,.section-heading>span{background:transparent;color:var(--muted);font-size:10px;padding:5px}.compact-list{display:grid;gap:8px}.compact-trap{min-height:73px;padding:10px;border:1px solid var(--line);border-radius:18px;background:rgba(6,27,38,.86);display:grid;grid-template-columns:30px 1fr auto auto;gap:9px;align-items:center}.compact-trap.ready,.compact-trap.stale{border-color:rgba(240,197,106,.42);background:linear-gradient(130deg,rgba(75,52,26,.7),rgba(7,30,39,.9))}.compact-buoy{height:48px;position:relative}.compact-buoy:after{content:"";position:absolute;width:1px;height:28px;left:50%;top:21px;background:rgba(201,235,219,.35)}.compact-buoy span{position:absolute;top:9px;left:8px;width:14px;height:14px;border-radius:50%;background:#cf5d49;box-shadow:0 3px 0 #e8d184}.compact-copy{min-width:0}.compact-copy small{display:block;font-size:9px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.compact-copy b{font-size:13px;display:block;margin:2px 0 6px}.thin-progress{height:4px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden}.thin-progress i{display:block;height:100%;background:var(--accent);border-radius:4px}.compact-trap.ready .thin-progress i,.compact-trap.stale .thin-progress i{background:var(--accent-2)}.compact-time{text-align:right;min-width:67px}.compact-time span{display:block;font-size:8px;color:var(--muted)}.compact-time b{display:block;font-size:10px;margin-top:3px;color:#d8e3dd}.mini-cta{height:34px;padding:0 10px;border-radius:11px;background:var(--accent-2);color:#2d250f;font-size:10px;font-weight:900}
.empty-card{min-height:150px;border:1px dashed rgba(180,226,213,.18);border-radius:22px;background:rgba(5,26,36,.65);display:grid;place-items:center;align-content:center;text-align:center;padding:22px}.empty-card>span{width:52px;height:52px;border-radius:18px;background:rgba(128,228,193,.08);color:var(--accent);display:grid;place-items:center}.empty-card h3{font-size:15px;margin:12px 0 5px}.empty-card p{margin:0;max-width:280px;color:var(--muted);font-size:11px;line-height:1.6}.harbor-actions{display:grid;grid-template-columns:1.65fr 1fr;gap:8px}.primary-action,.secondary-action{min-height:78px;border-radius:20px;border:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:12px;text-align:left}.primary-action{background:linear-gradient(135deg,#74d6b8,#a0efd3);color:#092b27;box-shadow:0 12px 28px rgba(44,157,127,.18)}.primary-action.ready{background:linear-gradient(135deg,#f3c767,#ffe29a);color:#382d11}.primary-action>span,.secondary-action>span{width:38px;height:38px;border-radius:13px;background:rgba(0,0,0,.11);display:grid;place-items:center;flex:0 0 auto}.primary-action .ui-icon,.secondary-action .ui-icon{width:20px}.primary-action>div,.secondary-action>div{min-width:0;display:grid;gap:3px}.primary-action b,.secondary-action b{font-size:13px}.primary-action small,.secondary-action small{font-size:9px;line-height:1.35;opacity:.75}.primary-action>.ui-icon{margin-left:auto;width:17px}.secondary-action{background:rgba(7,29,40,.86);color:var(--text)}.secondary-action>span{color:var(--accent-2);background:rgba(240,197,106,.09)}

.page-heading{padding:170px 4px 8px}.page-heading.compact{padding:12px 2px 8px}.page-heading h1{font-size:29px;line-height:1.1;margin:6px 0 8px}.page-heading p{margin:0;color:#a9c1bc;font-size:11px;line-height:1.55;max-width:390px}.trap-grid{display:grid;gap:11px}.trap-slot{border:1px solid var(--line);border-radius:22px;background:rgba(5,26,36,.88);overflow:hidden}.trap-slot.ready,.trap-slot.stale{border-color:rgba(240,197,106,.4);box-shadow:inset 0 0 32px rgba(240,197,106,.05)}.trap-slot>header{height:63px;padding:11px 13px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line)}.slot-number{width:38px;height:38px;border-radius:13px;background:rgba(128,228,193,.09);display:grid;place-items:center;color:var(--accent);font-weight:900}.trap-slot header div{min-width:0;flex:1}.trap-slot header small{display:block;font-size:8px;color:var(--muted);letter-spacing:.12em}.trap-slot header h3{margin:2px 0 0;font-size:15px}.quality{padding:5px 7px;border-radius:8px;font-size:8px;background:rgba(255,255,255,.06);color:var(--muted)}.quality.perfect{background:rgba(240,197,106,.13);color:var(--accent-2)}.quality.unstable{background:rgba(255,117,110,.12);color:#ff918b}.slot-sea{height:106px;position:relative;overflow:hidden;background:linear-gradient(180deg,rgba(37,118,126,.7),rgba(6,46,59,.95));border-bottom:1px solid var(--line)}.slot-sea:before,.slot-sea:after{content:"";position:absolute;left:-10%;width:120%;height:14px;border-top:2px solid rgba(193,237,223,.18);border-radius:50%;top:14px}.slot-sea:after{top:37px;opacity:.55}.buoy{position:absolute;left:24%;top:17px;width:18px;height:13px;border-radius:50%;background:#cc5f4b;box-shadow:0 -4px 0 #e8d083}.buoy i{position:absolute;width:2px;height:9px;left:8px;top:-10px;background:#ded5ac}.rope,.dashed-rope{position:absolute;left:calc(24% + 8px);top:31px;width:1px;background:rgba(228,238,203,.6)}.dashed-rope{height:55px;background:repeating-linear-gradient(to bottom,rgba(228,238,203,.35) 0 4px,transparent 4px 8px)}.trap-shape{position:absolute;left:calc(24% - 14px);bottom:9px;width:48px;height:34px;border:2px solid rgba(138,226,197,.72);border-radius:5px;background:rgba(5,29,39,.82);display:grid;place-items:center;color:var(--accent)}.trap-shape .ui-icon{width:26px}.slot-stats{display:grid;grid-template-columns:1.5fr 1.25fr .7fr;gap:8px;padding:10px 13px}.slot-stats span{min-width:0}.slot-stats small{display:block;color:var(--muted);font-size:8px}.slot-stats b{display:block;font-size:10px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.slot-progress{height:4px;margin:0 13px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden}.slot-progress i{display:block;height:100%;background:var(--accent);border-radius:4px}.ready .slot-progress i,.stale .slot-progress i{background:var(--accent-2)}.trap-slot>footer{padding:11px 13px 13px;display:flex;align-items:center;justify-content:space-between;gap:10px}.trap-slot footer small{display:block;font-size:8px;color:var(--muted)}.trap-slot footer b{display:block;font-size:11px;margin-top:2px}.slot-cta{min-width:92px;height:38px;border-radius:12px;background:var(--accent);color:#092a26;font-size:10px;font-weight:900}.slot-cta.muted{background:rgba(255,255,255,.06);color:var(--muted)}.trap-slot.empty .slot-sea{filter:saturate(.55)}.buoy.ghost{opacity:.4}.empty-slot-copy,.locked-copy{padding:13px;display:flex;align-items:center;gap:10px;justify-content:space-between}.empty-slot-copy p,.locked-copy p{margin:0;max-width:250px;color:var(--muted);font-size:10px;line-height:1.5}.trap-slot.locked{opacity:.65}.trap-slot.locked>header>.ui-icon{width:20px;color:var(--muted)}.locked-copy button{height:34px;border-radius:11px;background:rgba(128,228,193,.12);color:var(--accent);font-size:10px;padding:0 12px}

/* Deployment setup */
.setup-shell{height:100%;display:flex;flex-direction:column;background:linear-gradient(180deg,rgba(4,20,29,.52),rgba(4,18,27,.96) 38%,#06141e)}
.setup-scroll{flex:1;overflow-y:auto;padding:0 16px 126px;scrollbar-width:none}.setup-footer{position:absolute;left:0;right:0;bottom:0;padding:12px 14px calc(12px + var(--safe-bottom));background:linear-gradient(180deg,transparent,#06141e 30%)}
.setup-group{margin:10px 0;border:1px solid var(--line);border-radius:20px;background:rgba(6,27,37,.82);overflow:hidden}.setup-group summary{list-style:none;min-height:66px;padding:10px 13px;display:grid;grid-template-columns:38px 1fr 20px;gap:10px;align-items:center;cursor:pointer}.setup-group summary::-webkit-details-marker{display:none}.setup-group summary>span{width:36px;height:36px;border-radius:12px;background:rgba(128,228,193,.09);display:grid;place-items:center;color:var(--accent);font-size:11px;font-weight:900}.setup-group summary div{display:grid;gap:2px}.setup-group summary small{font-size:8px;color:var(--muted);letter-spacing:.14em}.setup-group summary b{font-size:14px}.setup-group summary>.ui-icon{width:17px;color:var(--muted);transition:transform .18s}.setup-group[open] summary>.ui-icon{transform:rotate(90deg)}.selection-list{display:grid;gap:7px;padding:0 9px 10px}.selection-card{width:100%;min-height:78px;padding:10px;border:1px solid rgba(180,226,213,.1);border-radius:16px;background:rgba(3,19,27,.62);display:grid;grid-template-columns:40px 1fr 20px;gap:9px;align-items:center;text-align:left}.selection-card.selected{border-color:rgba(128,228,193,.45);background:rgba(56,113,94,.2)}.selection-card.locked{filter:saturate(.45)}.selection-symbol{width:39px;height:39px;border-radius:13px;background:rgba(128,228,193,.08);color:var(--accent);display:grid;place-items:center}.selection-symbol .ui-icon{width:20px}.selection-card div{min-width:0}.selection-card div small{display:block;font-size:8px;color:var(--accent)}.selection-card div b{display:block;margin:2px 0;font-size:13px}.selection-card div p{margin:0;color:var(--muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.selection-card div i{display:block;margin-top:4px;color:#c7d6d0;font-size:9px;font-style:normal}.selection-card>.ui-icon{width:17px;color:var(--muted)}.selection-card.selected>.ui-icon{color:var(--accent)}.forecast-card{margin-top:12px;padding:15px;border:1px solid rgba(113,181,255,.2);border-radius:21px;background:linear-gradient(135deg,rgba(26,64,78,.8),rgba(5,27,38,.9))}.forecast-card header{display:flex;justify-content:space-between;align-items:center}.forecast-card header small{font-size:8px;color:#82bdfb;letter-spacing:.14em}.forecast-card h2{font-size:16px;margin:3px 0}.forecast-card header>.ui-icon{color:#82bdfb}.forecast-card>p{margin:8px 0 13px;font-size:10px;color:#b9cfce}.forecast-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.forecast-grid span{padding:9px;border-radius:12px;background:rgba(1,17,25,.42)}.forecast-grid small{display:block;font-size:8px;color:var(--muted)}.forecast-grid b{display:block;font-size:11px;margin-top:3px}.deploy-plan-button{width:100%;min-height:66px;border-radius:19px;background:linear-gradient(135deg,#77dbbc,#a4efd5);color:#082923;display:grid;grid-template-columns:42px 1fr 20px;gap:9px;align-items:center;text-align:left;padding:10px 14px;box-shadow:0 12px 30px rgba(34,143,113,.22)}.deploy-plan-button>span{width:40px;height:40px;border-radius:13px;background:rgba(0,0,0,.1);display:grid;place-items:center}.deploy-plan-button b{display:block;font-size:13px}.deploy-plan-button small{display:block;font-size:9px;opacity:.74;margin-top:2px}.deploy-plan-button>.ui-icon{width:17px}

/* Market */
