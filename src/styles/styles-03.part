.stage-track{height:52px;margin:8px 1px 0;display:grid;grid-template-columns:repeat(3,1fr);gap:4px}.stage-track span{position:relative;display:flex;align-items:center;gap:5px;justify-content:center;font-size:8px;color:#73938f}.stage-track span:after{content:"";position:absolute;left:0;right:0;bottom:3px;height:2px;background:rgba(255,255,255,.08)}.stage-track span.active{color:var(--accent);font-weight:800}.stage-track span.active:after{background:var(--accent)}.stage-track i{width:18px;height:18px;border-radius:7px;background:rgba(255,255,255,.06);display:grid;place-items:center;font-style:normal}.stage-track span.active i{background:rgba(128,228,193,.13)}.event-banner{min-height:52px;margin-top:5px;padding:9px 12px;border:1px solid var(--line);border-radius:16px;background:rgba(5,27,37,.56);display:grid;align-content:center;gap:2px;opacity:.72}.event-banner.show{opacity:1;animation:event-pulse .7s ease}.event-banner.danger{border-color:rgba(255,117,110,.55);background:rgba(85,30,31,.72)}.event-banner.warning{border-color:rgba(240,197,106,.45);background:rgba(73,54,25,.7)}.event-banner.current{border-color:rgba(114,181,255,.45);background:rgba(22,56,82,.72)}.event-banner b{font-size:12px}.event-banner span{font-size:9px;color:#c1d2cd}.game-readouts{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.game-readouts>span{padding:8px 9px;border-radius:13px;background:rgba(3,20,28,.62);border:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:3px}.game-readouts small{font-size:8px;color:var(--muted)}.game-readouts b{font-size:9px}.game-readouts>span>i{grid-column:1/3;height:4px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden}.game-readouts em{display:block;height:100%;background:var(--accent);border-radius:4px}.pull-panel{margin-top:auto;padding:14px;border:1px solid rgba(190,232,218,.18);border-radius:24px;background:rgba(4,23,32,.9);box-shadow:0 20px 50px rgba(0,0,0,.38);backdrop-filter:blur(12px);position:relative}.float-feedback{position:absolute;left:50%;top:-45px;transform:translate(-50%,10px) scale(.9);font-size:25px;font-weight:1000;letter-spacing:.04em;opacity:0;text-shadow:0 4px 15px rgba(0,0,0,.55);transition:.18s}.float-feedback.show{opacity:1;transform:translate(-50%,0) scale(1)}.float-feedback.perfect{color:#f6d576}.float-feedback.good{color:#8ce8c5}.float-feedback.miss{color:#ff857e}.timing-gauge{height:22px}.tension-row{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;margin:10px 2px}.tension-row small,.tension-row b{font-size:8px;color:var(--muted)}.tension-row>div{height:6px;border-radius:6px;background:linear-gradient(90deg,rgba(128,228,193,.2),rgba(240,197,106,.22),rgba(255,117,110,.25));overflow:hidden}.tension-row i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2),var(--danger));border-radius:6px}.combo-row{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-bottom:10px}.combo-row span{padding:6px;border-radius:10px;background:rgba(1,16,23,.4);text-align:center}.combo-row small{display:block;font-size:7px;color:var(--muted)}.combo-row b{display:block;font-size:11px;margin-top:2px}.hold-button{width:100%;height:66px;border-radius:19px;background:linear-gradient(135deg,#78dcbc,#a5efd5);color:#082923;display:grid;grid-template-columns:43px 1fr;gap:10px;align-items:center;text-align:left;padding:10px 13px;touch-action:none;user-select:none}.hold-button>span{width:41px;height:41px;border-radius:14px;background:rgba(0,0,0,.1);display:grid;place-items:center}.hold-button b{display:block;font-size:13px}.hold-button small{display:block;font-size:9px;opacity:.74;margin-top:2px}.hold-button.holding{transform:translateY(2px);filter:brightness(.9);box-shadow:inset 0 3px 8px rgba(0,0,0,.22)}.hold-button.danger{background:linear-gradient(135deg,#ff756e,#ffaaa1);animation:danger-button .5s infinite alternate}.hold-button.danger b:after{content:" · 손 떼기"}

@keyframes fade-in{from{opacity:0}to{opacity:1}}@keyframes modal-up{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}@keyframes catch-in{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:none}}@keyframes event-pulse{0%,100%{transform:none}50%{transform:scale(1.015)}}@keyframes danger-button{from{box-shadow:0 0 0 rgba(255,117,110,0)}to{box-shadow:0 0 24px rgba(255,117,110,.28)}}
.reduced-motion *{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
@media (min-width:521px){body{background:radial-gradient(circle at 50% 15%,#12394a,#040b10 70%)}.game-shell{border-left:1px solid rgba(255,255,255,.08);border-right:1px solid rgba(255,255,255,.08)}}
@media (max-height:720px){.harbor-hero{min-height:190px;padding-top:65px}.page-heading{padding-top:120px}.screen-scroll{padding-top:6px}.minigame{padding-top:calc(5px + var(--safe-top))}.stage-track{height:42px}.event-banner{min-height:44px}.game-readouts{margin-top:5px}.pull-panel{padding:11px}.hold-button{height:58px}.deploy-copy h2{font-size:19px}.deploy-controller{padding:13px}}
@media (max-width:360px){.coin-chip{padding:0 6px}.hero-stats>span{width:78px}.market-board{gap:3px}.collection-grid{gap:5px}.inventory-card{grid-template-columns:40px 1fr}.species-token{width:40px;height:40px}.upgrade-card,.shop-row{grid-template-columns:36px 1fr auto}.upgrade-card>span,.shop-row>span{width:36px;height:36px}.npc-row article{padding:6px 3px}}
