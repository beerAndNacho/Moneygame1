  const paths = {
    harbor:'<path d="M3 20h18M5 20v-8l7-6 7 6v8M9 20v-5h6v5M3 11l9-8 9 8"/>',
    trapline:'<path d="M6 5h12l2 15H4L6 5Zm1 4h10M6 14h12M9 5v15m6-15v15"/>',
    market:'<path d="M4 9h16l-1 11H5L4 9Zm2 0 2-5h8l2 5M8 13h8M8 17h5"/>',
    book:'<path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H12v18H7.5A3.5 3.5 0 0 0 4 23V5.5Zm16 0A3.5 3.5 0 0 0 16.5 2H12v18h4.5A3.5 3.5 0 0 1 20 23V5.5Z"/>',
    village:'<path d="M3 20h18M5 20v-9l7-6 7 6v9M9 20v-6h6v6M4 10l8-7 8 7"/>',
    coin:'<circle cx="12" cy="12" r="9"/><path d="M9 9.5c0-1.2 1.2-2 3-2s3 .8 3 2-1.2 2-3 2-3 .8-3 2 1.2 2 3 2 3-.8 3-2M12 5.5v13"/>',
    clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    anchor:'<path d="M12 3v15M8 7h8M5 13c0 5 3 8 7 8s7-3 7-8M5 13l-2 3m16-3 2 3"/><circle cx="12" cy="4" r="1.5"/>',
    bait:'<path d="M6 7c5 0 8 3 8 7a4 4 0 0 1-8 0c0-3 2-5 5-5M14 14c3 0 5-2 5-5V4"/>',
    settings:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M19 5l-2 2M7 17l-2 2"/>',
    lock:'<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
    check:'<path d="m4 12 5 5L20 6"/>',
    close:'<path d="M5 5l14 14M19 5 5 14"/>',
    arrow:'<path d="m9 5 7 7-7 7"/>',
    back:'<path d="m15 5-7 7 7 7"/>',
    sonar:'<circle cx="12" cy="12" r="2"/><path d="M7.8 7.8a6 6 0 0 0 0 8.4m8.4 0a6 6 0 0 0 0-8.4M4.6 4.6a10.5 10.5 0 0 0 0 14.8m14.8 0a10.5 10.5 0 0 0 0-14.8"/>',
    box:'<path d="M4 7h16v13H4V7Zm2-3h12l2 3H4l2-3Zm3 7h6"/>',
    wave:'<path d="M2 10c3-4 5 4 8 0s5 4 8 0 4 1 4 1M2 16c3-4 5 4 8 0s5 4 8 0 4 1 4 1"/>',
    bell:'<path d="M6 17h12l-2-3V9a4 4 0 0 0-8 0v5l-2 3Zm4 3h4"/>',
    wrench:'<path d="M14 6a4 4 0 0 0-5 5L3 17l4 4 6-6a4 4 0 0 0 5-5l-3 3-3-3 2-4Z"/>',
    cart:'<path d="M3 4h2l2 11h10l3-8H6M9 20h.1M17 20h.1"/>',
    play:'<path d="m8 5 11 7-11 7V5Z"/>',
