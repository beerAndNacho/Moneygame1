export function getDailyQuestIds(day = 1) {
  const random = mulberry32(hashString(`daily-quests-${day}`));
  const pool = [...QUESTS];
  const picked = [];
  while (pool.length && picked.length < 3) {
    const index = Math.floor(random() * pool.length);
    picked.push(pool.splice(index, 1)[0].id);
  }
  return picked;
}

