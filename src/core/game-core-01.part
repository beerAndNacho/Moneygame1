export const getById = (items, id) => items.find((item) => item.id === id);
export const getSpecies = (id) => getById(SPECIES, id);
export const getLocation = (id) => getById(LOCATIONS, id);
export const getTrap = (id) => getById(TRAPS, id);
export const getBait = (id) => getById(BAITS, id);
export const getUpgrade = (id) => getById(BOAT_UPGRADES, id);

export function judgeTiming(marker, zoneCenter, zoneWidth) {
  const distance = Math.abs(marker - zoneCenter);
  if (distance <= zoneWidth * .28) return 'perfect';
  if (distance <= zoneWidth * .68) return 'good';
  return 'miss';
}

export function judgePlacement(marker, targetCenter, targetWidth) {
  const judgement = judgeTiming(marker, targetCenter, targetWidth);
  return judgement === 'perfect' ? 'perfect' : judgement === 'good' ? 'stable' : 'unstable';
}

export function calculatePullOutcome({
  judgement,
  combo = 0,
  pullPower = 1,
  stability = 1,
  current = 1,
  dangerActive = false,
  damageMitigation = 0,
  stage = 'midwater',
  random = Math.random,
}) {
  const mitigation = clamp(1 - damageMitigation, .55, 1);
  if (dangerActive) {
    return {
      depthGain: 0,
      tensionGain: (.3 + random() * .14) * mitigation,
      durabilityLoss: Math.max(1, Math.round((4 + random() * 4) * mitigation)),
      lockLoss: Math.max(3, Math.round((11 + random() * 9) * mitigation)),
      scoreGain: 0,
      comboDelta: -Math.max(1, combo),
    };
  }

  const stageDepth = stage === 'seabed' ? .84 : stage === 'surface' ? .92 : 1;
  const stageTension = stage === 'seabed' ? 1.16 : stage === 'surface' ? 1.13 : 1;
  const instability = Math.max(0, current - stability);
